# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git. NEVER commit real keys.

# Supabase: Project Settings > API Keys (added in Phase 3)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# The "publishable" key (sb_publishable_...). It is safe in the browser because
# Row Level Security protects the data. Older projects call this the "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# The ONLY email allowed into /admin (server-side only, no NEXT_PUBLIC_ prefix)
ADMIN_EMAIL=you@example.com

# Resend API key, for emailing you when a contact message arrives (optional;
# without it, messages still go to the admin inbox). Free at resend.com:
# sign up with the same email as ADMIN_EMAIL, then API Keys > Create.
RESEND_API_KEY=

# Google Search Console "HTML tag" verification code (optional): only the code
# inside content="...", not the whole <meta> tag. Not secret.
GOOGLE_SITE_VERIFICATION=

# Full site URL, used for SEO metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
